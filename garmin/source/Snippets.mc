using Toybox.Lang;

//! Bookmarks sublabel text: the start of the verse itself (Dylan 2026-11-03), cached per bookmark.
//! The BSB pack merges each psalm's superscription ("A Psalm of David.", "For the choirmaster. …")
//! into verse 1's text, so Psalm 23:1 read "A Psalm of…". PS_TITLE[c-1] is the length (characters)
//! of that title in Psalm c verse 1, 0 when it has none; generated by tools/ps_titles.py
//! (labs/garmin/tools) from resources/bsb/b18c*.json. Section headings ("h") are never part of "t".
module Snippets {
    // POKE: BOOKMARK_SNIPPET_CHARS — native-row sublabel room ("Through Him all…", word cut).
    const CHARS = 22;
    const PSALMS = 18; // book index
    const PS_TITLE = [
        0, 0, 53, 66, 68, 90, 91, 61, 78, 0, 31, 63, 39, 31, 18,
        19, 19, 193, 39, 39, 39, 77, 18, 18, 10, 10, 10, 10, 18, 60,
        39, 20, 0, 92, 10, 64, 10, 35, 53, 39, 39, 52, 0, 52, 94,
        73, 51, 38, 51, 18, 110, 134, 63, 140, 67, 122, 111, 73, 137, 217,
        58, 62, 58, 39, 47, 38, 65, 47, 56, 53, 0, 12, 18, 19, 80,
        74, 62, 19, 18, 84, 53, 18, 26, 73, 51, 19, 38, 123, 32, 34,
        0, 37, 0, 0, 0, 0, 0, 9, 0, 25, 18, 96, 10, 0, 0,
        0, 0, 26, 39, 18, 0, 0, 0, 0, 0, 0, 0, 0, 0, 19,
        19, 29, 19, 29, 19, 19, 31, 19, 19, 19, 29, 19, 29, 19, 0,
        0, 0, 10, 39, 39, 18, 54, 18, 10, 29, 0, 0, 0, 0, 0
    ];
    // POKE: SNIPPET_CACHE_MAX — snippets kept this session (each costs a chapter load once).
    const CACHE_MAX = 60;
    var _cache as Lang.Dictionary = {};

    //! Verse text without a psalm superscription.
    function body(book as Lang.Number, chapter as Lang.Number, verse as Lang.Number, t as Lang.String) as Lang.String {
        if (book == PSALMS && verse == 1 && chapter >= 1 && chapter <= PS_TITLE.size()) {
            var n = PS_TITLE[chapter - 1] as Lang.Number;
            if (n > 0 && n < t.length()) {
                return t.substring(n, t.length()) as Lang.String;
            }
        }
        return t;
    }

    //! Snippet for a bookmark id (null for a whole-chapter bookmark or a missing verse).
    function of(id as Lang.Number) as Lang.String or Null {
        var c = _cache[id];
        if (c != null) {
            return c instanceof Lang.String ? c as Lang.String : null;
        }
        var s = make(id);
        if (_cache.size() >= CACHE_MAX) {
            _cache = {};
        }
        _cache[id] = s != null ? s : false;
        return s;
    }

    function make(id as Lang.Number) as Lang.String or Null {
        var v = Bookmarks.unpackVerse(id);
        if (v <= 0) {
            return null;
        }
        var b = Bookmarks.unpackBook(id);
        var ch = Bookmarks.unpackChapter(id);
        var t = ContentLoader.verseText(b, ch, v);
        if (t == null) {
            return null;
        }
        var s = ContentLoader.plainVerseText(body(b, ch, v, t as Lang.String));
        if (s.length() <= CHARS) {
            return s;
        }
        s = s.substring(0, CHARS + 1) as Lang.String; // +1: a word ending exactly at the limit stays
        var k = RoundLayout.lastSpaceAt(s);
        return (k > 0 ? s.substring(0, k) : s) + "…";
    }
}
