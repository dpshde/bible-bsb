<?xml version="1.0"?>
<!--
  Connect IQ manifest for BSB Bible spike.
  Products: Enduro 3 primary + budget lines from SPEC.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application id="a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                    type="watch-app"
                    name="@Strings.AppName"
                    entry="BsbBibleApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.2.0">
        <iq:products>
            <!-- Primary -->
            <iq:product id="enduro3"/>
            <!-- Forerunner class -->
            <iq:product id="fr165"/>
            <iq:product id="fr165m"/>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fr965"/>
            <!-- Venu / Sq -->
            <iq:product id="venu2"/>
            <iq:product id="venu2s"/>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
            <iq:product id="venusq2"/>
            <iq:product id="venusq2m"/>
            <!-- Vivoactive -->
            <iq:product id="vivoactive5"/>
            <iq:product id="vivoactive6"/>
        </iq:products>
        <iq:permissions>
            <!-- Hidden Word bookmark sync (off by default; no calls unless a sync key is set
                 and "Sync bookmarks" is on in Garmin Connect settings). -->
            <iq:uses-permission id="Communications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
