    <font id="BodyMedium14" filename="body_regular_14.fnt" antialias="true"/>
    <font id="BodyMedium16" filename="body_medium_16.fnt" antialias="true"/>
    <font id="NumBold11" filename="num_bold_11.fnt" antialias="true" filter="0123456789"/>
    <font id="HeaderCaps11" filename="header_caps_11.fnt" antialias="true"/>
</fonts>
