# Connect IQ jungle — BSB Bible spike
project.manifest = manifest.xml

# Base resources + sources for all devices
base.sourcePath = source;test
base.resourcePath = resources

# Round MIP / AMOLED can later add resource overlays (POKE: per-class fonts/insets)
# enduro3.resourcePath = resources;resources-round
# fr265.resourcePath = resources;resources-round
# venusq2.resourcePath = resources;resources-rectangle

# Palette: MIP (64-color) devices get palette-exact gold; everyone else true gold.
base.excludeAnnotations = mip
enduro3.excludeAnnotations = amoled
