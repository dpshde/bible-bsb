    function getResourceId(bookIndex as Number, chapter as Number) as ResourceId? {
                if (bookIndex == 0) {
            if (chapter >= 1 && chapter <= 10) {
                return GEN_RESOURCES[chapter - 1];
            }
                } else if (bookIndex == 18) {
            if (chapter >= 1 && chapter <= 150) {
                return PSA_RESOURCES[chapter - 1];
            }
                } else if (bookIndex == 19) {
