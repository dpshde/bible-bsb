            }
                } else if (bookIndex == 65) {
            if (chapter >= 1 && chapter <= 22) {
                return REV_RESOURCES[chapter - 1];
            }
        }
        return null;
    }

    function hasResource(bookIndex as Number, chapter as Number) as Boolean {
        return getResourceId(bookIndex, chapter) != null;
    }

    function getTotalResourceCount() as Number {
        return 451;
    }

}
